{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StuStu",
  "mainBinaryName": "stustu",
  "version": "../package.json",
  "identifier": "io.github.whiskm.stustu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:native",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StuStu",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "backgroundColor": "#EEF2EC",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Учебный планер: расписание, домашние задания, экзамены",
    "longDescription": "StuStu — учебный планер для студента: расписание с чередованием недель, домашние задания, экзамены и подготовка к ним, посещаемость, заметки и статистика. Без регистрации: все данные хранятся только на этом компьютере.",
    "copyright": "© StuStu",
    "homepage": "https://github.com/whiskm/StuStu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
