{
  "name": "stustu",
  "private": true,
  "version": "3.0.0",
  "description": "StuStu — учебный планер: расписание, домашние задания, экзамены, посещаемость. Данные хранятся только на устройстве.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:native": "tsc --noEmit && vite build --mode native",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build:native && cap sync android",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
